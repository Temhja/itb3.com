Options -Indexes
RewriteEngine On
# data/ holds orders, messages, uploads and the admin password hash: never served directly.
# Only the public product catalog is readable.
RewriteRule ^data/(?!products\.json$) - [F,L]
RewriteRule ^api/_ - [F,L]
RewriteRule ^tools/ - [F,L]
RewriteRule ^(README\.md|\.gitignore)$ - [F,L]
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
